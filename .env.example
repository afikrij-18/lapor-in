# Template environment variable Lapor.in (PRD bagian 7.4).
# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# --- Frontend (terbaca di browser, wajib berawalan VITE_) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_TURNSTILE_SITE_KEY=
# Mode mock: isi "true" agar /api/* dibalas data contoh (tanpa endpoint dan tanpa kuota Gemini).
# Hanya berlaku saat npm run dev. Isi "false" untuk memakai endpoint sungguhan.
VITE_USE_MOCK_API=false

# --- Backend serverless (rahasia server, tidak boleh berawalan VITE_) ---
# Pakai key development di sini. Key demo hanya dipasang di environment Production Vercel.
GEMINI_API_KEY=
TURNSTILE_SECRET_KEY=
# Isi service account Firebase dalam satu baris JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Email kontak untuk header User-Agent Nominatim
OSM_CONTACT_EMAIL=
# Rahasia untuk cron /api/cleanup-audio
CRON_SECRET=
